NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:5000/health

MONGODB_URI=mongodb://localhost:27017/sportsbuddy
JWT_SECRET=replace-with-a-long-random-secret

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

EMAIL_USERNAME=your-email-username
EMAIL_PASSWORD=your-email-password
FROM_NAME=SportsBuddy
FROM_EMAIL=no-reply@example.com

RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

ENABLE_KEEP_ALIVE=false
KEEP_ALIVE_START_HOUR=9
KEEP_ALIVE_END_HOUR=21

RATE_LIMIT_GLOBAL_MAX=1200
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_PASSWORD_RESET_MAX=6
RATE_LIMIT_ADMIN_READ_MAX=240
RATE_LIMIT_ADMIN_WRITE_MAX=90
RATE_LIMIT_NOTIFICATION_SEND_MAX=30
RATE_LIMIT_PUBLIC_SEARCH_MAX=120
RATE_LIMIT_USER_WRITE_MAX=90
RATE_LIMIT_UPLOAD_MAX=40

CACHE_EVENTS_TTL=1800
CACHE_LEADERBOARD_TTL=900
CACHE_ATHLETES_TTL=3600
CACHE_VENUES_TTL=3600
CACHE_COMMUNITY_TTL=1800
CACHE_ADMIN_TTL=1800
CACHE_DEFAULT_TTL=3600
